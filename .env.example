# Jev (TypeSafe). Leave blank and the gates run against the stand-in.
# Copy this file to .env; .env is git-ignored, so the real key never gets committed.
TYPESAFE_API_KEY=

# Google Jules API key. Leave blank and Jules runs simulated.
# Set this to run Jules live: sessions will be created on https://jules.google.com.
JULES_API_KEY=

# Set to 1 only if other computers on your network should be able to use the gates.
JEV_ALLOW_LAN=
